# Copy to .env.production, replace every placeholder, chmod 600, and never commit it.
BURK_SCM_ENV_FILE=.env.production
BURK_SCM_IMAGE_TAG=local
BURK_SCM_HTTP_PORT=8080

POSTGRES_DB=burk_scm
POSTGRES_USER=burk_scm
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://burk_scm:replace-with-url-encoded-password@db:5432/burk_scm

DEBUG=False
PRODUCTION_MODE=True
SECRET_KEY=replace-with-a-long-random-django-secret
ALLOWED_HOSTS=scm.example.com
FRONTEND_ORIGIN=https://scm.example.com
PUBLIC_APP_ORIGIN=https://scm.example.com
CSRF_TRUSTED_ORIGINS_EXTRA=https://www.scm.example.com
DEMO_MODE_ENABLED=False
DEMO_ACTIONS_ENABLED=False
ALLOW_DEMO_RESET=False
REQUIRE_LIVE_INTEGRATIONS=True
TRUST_X_FORWARDED_PROTO=True
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media

ORDER_CONNECTOR_BACKENDS={"burk":"live","daraz":"live"}
DARAZ_APP_KEY=replace-from-secret-store
DARAZ_APP_SECRET=replace-from-secret-store
DARAZ_ACCESS_TOKEN=replace-from-secret-store
DARAZ_API_BASE_URL=https://api.example.invalid/daraz
BURK_ORDER_API_BASE_URL=https://api.example.invalid/burk/orders
BURK_ORDER_API_TOKEN=replace-from-secret-store

PACKAGING_CAMERA_BACKEND=live
PACKAGING_CAMERA_SOURCE=rtsp://camera-host/private-stream
COURIER_BACKEND=live_leopard
LEOPARD_API_KEY=replace-from-secret-store
LEOPARD_API_PASSWORD=replace-from-secret-store
COURIER_WEBHOOK_SECRETS={"leopard":"replace-from-secret-store"}

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-from-secret-store
EMAIL_HOST_PASSWORD=replace-from-secret-store
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Burk.pk <no-reply@burk.pk>
WHATSAPP_BACKEND=live
WHATSAPP_ACCESS_TOKEN=replace-from-secret-store
WHATSAPP_PHONE_NUMBER_ID=replace-with-approved-sender-id
NOTIFICATION_WEBHOOK_SECRETS={"whatsapp":"replace-from-secret-store"}
REVIEW_LINK_BACKEND=live_burk
BURK_REVIEW_API_BASE_URL=https://api.example.invalid/burk/reviews
BURK_REVIEW_API_TOKEN=replace-from-secret-store
